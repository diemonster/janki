# Python bytecode and packaging metadata
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Generated Anki packages and previews (dist/.gitkeep is tracked)
dist/*.apkg
dist/*-preview.html

# Nothing under data/ is ignored, deliberately. data/staging/ holds hand-typed
# readings and data/media/ holds cached audio; both are only recoverable if they
# are committed, and both ship a .gitkeep so they exist in a fresh clone.
# See AGENTS.md "Data lifecycle".

# macOS
.DS_Store
