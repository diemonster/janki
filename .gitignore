# Python bytecode and packaging metadata
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Generated Anki packages and previews (dist/.gitkeep is tracked)
dist/*.apkg
dist/*-preview.html

# Nothing under data/ is ignored, deliberately. data/staging/ holds hand-typed
# readings and data/media/ holds cached audio; both are only recoverable if they
# are committed, and both ship a .gitkeep so they exist in a fresh clone.
# See AGENTS.md "Data lifecycle".

# Secrets. Nothing in janki reads a .env file — keys come from the real
# environment (JPDB_API_KEY, ANTHROPIC_API_KEY, AZURE_SPEECH_KEY). This
# entry exists so that a .env kept here for convenience can never be
# committed by an "add everything" commit.
.env
.env.*
!.env.example

# Claude Code state and config, all of it local to a machine. settings.json
# pins per-developer model choices and agents/ is personal tooling, so neither
# is something a clone should inherit; AGENTS.md is the instructions that are
# meant to be shared, and it is tracked.
.claude/

# macOS
.DS_Store
